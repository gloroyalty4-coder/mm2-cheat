Stroke.Color = Color3.fromRGB(0, 255, 255) -- Cyan Border
Stroke.Thickness = 2

local function CreateBtn(text, pos, color)
    local b = Instance.new("TextButton")
    b.Parent = Bar
    b.Size = UDim2.new(0, 80, 0, 40)
    b.Position = pos
    b.BackgroundColor3 = color
    b.Text = text
    b.TextColor3 = Color3.new(1,1,1)
    b.Font = Enum.Font.GothamBold
    Instance.new("UICorner", b)
    return b
end

local PrevBtn = CreateBtn("< PREV", UDim2.new(0.05, 0, 0.1, 0), Color3.fromRGB(40, 40, 40))
local CloseBtn = CreateBtn("CLOSE", UDim2.new(0.37, 0, 0.1, 0), Color3.fromRGB(255, 50, 50)) -- Red
local NextBtn = CreateBtn("NEXT >", UDim2.new(0.68, 0, 0.1, 0), Color3.fromRGB(40, 40, 40))

local function UpdateSpectate(dir)
    local players = game.Players:GetPlayers()
    SpectateIndex = SpectateIndex + dir
    if SpectateIndex > #players then SpectateIndex = 1 end
    if SpectateIndex < 1 then SpectateIndex = #players end
    local target = players[SpectateIndex]
    if target and target.Character and target.Character:FindFirstChild("Humanoid") then
        Camera.CameraSubject = target.Character.Humanoid
    end
end

NextBtn.MouseButton1Click:Connect(function() UpdateSpectate(1) end)
PrevBtn.MouseButton1Click:Connect(function() UpdateSpectate(-1) end)
CloseBtn.MouseButton1Click:Connect(function() 
    SpectateGui.Enabled = false
    Camera.CameraSubject = Player.Character.Humanoid 
end)

