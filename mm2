local function CreateSpecBtn(text, pos, color, func)
    local b = Instance.new("TextButton", Bar)
    b.Size = UDim2.new(0, 85, 0, 38)
    b.Position = pos
    b.BackgroundColor3 = color
    b.Text = text
    b.TextColor3 = Color3.new(1,1,1)
    b.Font = Enum.Font.GothamBold
    b.TextSize = 12
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
    b.MouseButton1Click:Connect(func)
end

local SpectateIndex = 1
local function UpdateSpec(dir)
    local plrs = game.Players:GetPlayers()
    if #plrs == 0 then return end
    SpectateIndex = (SpectateIndex + dir - 1) % #plrs + 1
    local target = plrs[SpectateIndex]
    if target and target.Character then Camera.CameraSubject = target.Character:FindFirstChildOfClass("Humanoid") end
end

CreateSpecBtn("< PREV", UDim2.new(0.03, 0, 0.12, 0), Color3.fromRGB(35, 35, 35), function() UpdateSpec(-1) end)
CreateSpecBtn("CLOSE", UDim2.new(0.36, 0, 0.12, 0), Color3.fromRGB(255, 45, 45), function() 
    SpectateGui.Enabled = false
    Camera.CameraSubject = Player.Character:FindFirstChildOfClass("Humanoid")
end)
CreateSpecBtn("NEXT >", UDim2.new(0.69, 0, 0.12, 0), Color3.fromRGB(35, 35, 35), function() UpdateSpec(1) end)

