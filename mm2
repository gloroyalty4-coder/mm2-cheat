local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "Riel Hub | Developer kitaroriel",
   LoadingTitle = "Riel Hub",
   LoadingSubtitle = "by kitaroriel",
   ConfigurationSaving = {Enabled = true, FolderName = "RielHub", FileName = "Config"},
   KeySystem = false, 
})

-- [[ 1. HOME TAB (Target Section) ]] --
local HomeTab = Window:CreateTab("Home", "home") 

-- Creating the "Account Info" Section matching your image
local AccountSection = HomeTab:CreateSection("Account Info")

-- User Information Label
HomeTab:CreateLabel("User Information")

-- Rejoin Server Button
HomeTab:CreateButton({
   Name = "Rejoin Server",
   Interact = 'Refresh koneksi server', -- Subtext from your image
   Callback = function()
      local ts = game:GetService("TeleportService")
      local p = game.Players.LocalPlayer
      ts:Teleport(game.PlaceId, p) -- This actually restarts your game session
   end,
})

