-- [[ TARGET TAB ]] --
TargetTab:CreateSection("Target Selection")
TargetTab:CreateInput({Name = "Target Username", PlaceholderText = "Enter name...", Callback = function(T) _G.TargetName = T end})
TargetTab:CreateButton({
    Name = "Teleport to Target", 
    Callback = function()
        local t = GetPlayer(_G.TargetName)
        if t and t.Character then 
            Player.Character.HumanoidRootPart.CFrame = t.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, -3) 
        end
    end
})

-- [[ TROLL TAB ]] --
TrollTab:CreateSection("Troll Actions")
TrollTab:CreateInput({Name = "Troll Target", PlaceholderText = "Enter target...", Callback = function(T) _G.TrollTarget = T end})
TrollTab:CreateButton({
    Name = "Fling Target",
    Callback = function()
        local t = GetPlayer(_G.TrollTarget)
        if t and t.Character then
            local hrp = Player.Character.HumanoidRootPart
            local oldPos = hrp.CFrame
            hrp.CFrame = t.Character.HumanoidRootPart.CFrame
            hrp.Velocity = Vector3.new(999999, 999999, 999999)
            task.wait(0.2)
            hrp.Velocity = Vector3.new(0,0,0)
            hrp.CFrame = oldPos
        end
    end
})

-- [[ SPECTATE TAB ]] --
SpectateTab:CreateSection("Spectator Mode")
SpectateTab:CreateToggle({
   Name = "Enable Spectator",
   CurrentValue = false,
   Callback = function(V) 
       if V then
           -- Basic Spectate Logic
           local plrs = game.Players:GetPlayers()
           if #plrs > 1 then
                Camera.CameraSubject = plrs[2].Character.Humanoid
           end
       else
           Camera.CameraSubject = Player.Character.Humanoid
       end
   end,
})

