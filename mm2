local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "Riel Hub | Developer kitaroriel",
   LoadingTitle = "Riel Hub┃Free",
   LoadingSubtitle = "by kitaroriel",
   ConfigurationSaving = {
      Enabled = true,
