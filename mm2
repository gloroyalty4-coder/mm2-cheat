local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "Riel Hub | Developer kitaroriel",
   LoadingTitle = "Riel Hub",
   LoadingSubtitle = "by kitaroriel",
   ConfigurationSaving = {
      Enabled = true,
      FolderName = "RielHub", 
      FileName = "Config"
   },
   Discord = {
      Enabled = false,
      Invite = "noinvite", 
      RememberJoins = true 
   },
   KeySystem = false,
})

-- [[ SIDEBAR TABS SETUP ]] --
-- These are created in the exact order of your sidebar image
local HomeTab = Window:CreateTab("Home", "home") 
local MainTab = Window:CreateTab("Main", "code")
local TargetTab = Window:CreateTab("Target", "crosshair")
local TrollTab = Window:CreateTab("Troll", "smile")
local SpectateTab = Window:CreateTab("Spectate", "eye")
local AnimTab = Window:CreateTab("Anim", "user")
local EmotesTab = Window:CreateTab("Emotes", "gamepad-2")
local SettingsTab = Window:CreateTab("Settings", "settings")

-- [[ HOME TAB CONTENT ]] --
-- This replicates the "Account Info" image 1:1
local HomeSection = HomeTab:CreateSection("Account Info")

HomeTab:CreateLabel("User Information")

HomeTab:CreateButton({
   Name = "Rejoin Server",
   Interact = 'Refresh koneksi server',
   Callback = function()
      local ts = game:GetService("TeleportService")
      local p = game.Players.LocalPlayer
      ts:Teleport(game.PlaceId, p)
   end,
})

-- [[ TROLL TAB CONTENT ]] --
-- This replicates the "Actions" image 1:1
local TrollSection = TrollTab:CreateSection("Actions")

TrollTab:CreateInput({
   Name = "Troll Target Username",
   PlaceholderText = "Enter troll target...",
   RemoveTextAfterFocusLost = false,
   Callback = function(Text)
      _G.TargetName = Text
   end,
})

TrollTab:CreateButton({
   Name = "Void Target (Kill)",
   Callback = function()
      print("Targeting " .. tostring(_G.TargetName) .. " for Void.")
   end,
})

TrollTab:CreateButton({
   Name = "Loop Fling Target",
   Callback = function()
      print("Targeting " .. tostring(_G.TargetName) .. " for Fling.")
   end,
})

TrollTab:CreateToggle({
   Name = "Walk On Air (Smart)",
   CurrentValue = false,
   Flag = "WalkAirToggle",
   Callback = function(Value)
      _G.WalkOnAir = Value
      -- Logic to prevent falling
      game:GetService("RunService").Stepped:Connect(function()
         if _G.WalkOnAir then
            local char = game.Players.LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
               char.HumanoidRootPart.Velocity = Vector3.new(char.HumanoidRootPart.Velocity.X, 0, char.HumanoidRootPart.Velocity.Z)
            end
         end
      end)
   end,
})

-- [[ SETTINGS TAB CONTENT ]] --
local SettingsSection = SettingsTab:CreateSection("Menu Settings")

SettingsTab:CreateButton({
   Name = "Destroy UI",
   Callback = function()
      Rayfield:Destroy()
   end,
})

-- [[ PROFILE NOTIFICATION ]] --
-- This mimics the profile info (6sixig) shown at the bottom of your image
local Player = game.Players.LocalPlayer
Rayfield:Notify({
   Title = "Riel Hub: " .. Player.DisplayName,
   Content = "Logged in as @" .. Player.Name,
   Duration = 6.5,
   Image = "rbxthumb://type=AvatarHeadShot&id=" .. Player.UserId .. "&w=150&h=150",
})

print("Riel Hub fully loaded.")
